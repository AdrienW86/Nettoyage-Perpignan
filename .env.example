# --- Envoi des demandes de devis (noms inchangés par rapport au site historique) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les demandes
CONTACT_EMAIL=
# Optionnel : expéditeur affiché (par défaut SMTP_USER). Doit appartenir au domaine SMTP (SPF/DKIM).
SMTP_FROM=
# Optionnel : true = aucun e-mail réel (recette, tests). Ne jamais activer en production.
CONTACT_DRY_RUN=

# --- Limitation de débit persistante (recommandée en production serverless) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sel du hachage des adresses IP
RATE_LIMIT_SALT=

# --- Cloudflare Turnstile (optionnel, les deux clés sont nécessaires) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
